{
	"name": "df_silver_races",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_races",
						"type": "DatasetReference"
					},
					"name": "source1",
					"description": "."
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_races",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"description": "."
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1",
					"description": "."
				},
				{
					"name": "derivedColumn2",
					"description": "."
				},
				{
					"name": "derivedColumn3",
					"description": "."
				},
				{
					"name": "derivedColumn4",
					"description": "."
				}
			],
			"scriptLines": [
				"source(output(",
				"          raceId as string,",
				"          year as string,",
				"          round as string,",
				"          circuitId as string,",
				"          name as string,",
				"          date as string,",
				"          time as string,",
				"          url as string,",
				"          fp1_date as string,",
				"          fp1_time as string,",
				"          fp2_date as string,",
				"          fp2_time as string,",
				"          fp3_date as string,",
				"          fp3_time as string,",
				"          quali_date as string,",
				"          quali_time as string,",
				"          sprint_date as string,",
				"          sprint_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(raceId = toInteger(raceId),",
				"          year = toShort(year),",
				"          round = toShort(round),",
				"          circuitId = toInteger(circuitId),",
				"          name = trim(name)) ~> derivedColumn1",
				"derivedColumn1 derive(date = iif(",
				"          regexMatch(date, `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`),",
				"          toDate(date, 'yyyy-MM-dd'),",
				"          iif(",
				"               regexMatch(date, `^[0-9]{2}/[0-9]{2}/[0-9]{4}$`),",
				"               toDate(date, 'dd/MM/yyyy'),",
				"               iif(",
				"                    regexMatch(date, `^[0-9]{4}/[0-9]{2}/[0-9]{2}$`),",
				"                    toDate(date, 'yyyy/MM/dd'),",
				"                    iif(",
				"                         regexMatch(date, `^[0-9]{2}-[0-9]{2}-[0-9]{4}$`),",
				"                         toDate(date, 'MM-dd-yyyy'),",
				"                         toDate(date, 'dd-MMM-yyyy')",
				"                    )",
				"               )",
				"          )",
				"     )) ~> derivedColumn2",
				"derivedColumn2 derive(fp1_date = iif(fp1_date == `\\N`, toDate(null()), toDate(fp1_date, 'yyyy-MM-dd')),",
				"          fp2_date = iif(fp2_date == `\\N`, toDate(null()), toDate(fp2_date, 'yyyy-MM-dd')),",
				"          fp3_date = iif(fp3_date == `\\N`, toDate(null()), toDate(fp3_date, 'yyyy-MM-dd')),",
				"          quali_date = iif(quali_date == `\\N`, toDate(null()), toDate(quali_date, 'yyyy-MM-dd')),",
				"          sprint_date = iif(sprint_date == `\\N`, toDate(null()), toDate(sprint_date, 'yyyy-MM-dd'))) ~> derivedColumn3",
				"derivedColumn3 derive(time = iif(time == `\\N`, toString(null()), time),",
				"          fp1_time = iif(fp1_time == `\\N`, toString(null()), fp1_time),",
				"          fp2_time = iif(fp2_time == `\\N`, toString(null()), fp2_time),",
				"          fp3_time = iif(fp3_time == `\\N`, toString(null()), fp3_time),",
				"          quali_time = iif(quali_time == `\\N`, toString(null()), quali_time),",
				"          sprint_time = iif(sprint_time == `\\N`, toString(null()), sprint_time)) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          raceId as integer,",
				"          year as integer,",
				"          round as integer,",
				"          circuitId as integer,",
				"          name as string,",
				"          date as date,",
				"          time as timestamp,",
				"          url as string,",
				"          fp1_date as date,",
				"          fp1_time as timestamp,",
				"          fp2_date as date,",
				"          fp2_time as timestamp,",
				"          fp3_date as date,",
				"          fp3_time as timestamp,",
				"          quali_date as date,",
				"          quali_time as timestamp,",
				"          sprint_date as date,",
				"          sprint_time as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          raceId,",
				"          year,",
				"          round,",
				"          circuitId,",
				"          name,",
				"          date,",
				"          time,",
				"          url,",
				"          fp1_date,",
				"          fp1_time,",
				"          fp2_date,",
				"          fp2_time,",
				"          fp3_date,",
				"          fp3_time,",
				"          quali_date,",
				"          quali_time,",
				"          sprint_date,",
				"          sprint_time",
				"     )) ~> sink1"
			]
		}
	}
}